{
  "name": "ryugu-38cm-s",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "RYUGU 38cm/s — 非公式ファンサイト（JAXA/ISAS非公式）",
  "scripts": {
    "precompute": "bash ../tools/precompute/run_all.sh",
    "check-assets": "node ./check-assets.mjs",
    "dev": "vite",
