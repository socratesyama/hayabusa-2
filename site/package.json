    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test:features": "node ./tests/features_core.test.mjs",
    "test:thermal": "node ./tests/thermal.test.mjs"
  },
  "dependencies": {
    "three": "^0.160.1"
  },
  "devDependencies": {
    "@types/three": "^0.160.0",
    "typescript": "^5.4.0",
    "vite": "^5.2.0"
  }
}
